# Bob-Guard Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# IBM Bob API Configuration (REQUIRED)
# ============================================
# Each team member should use their own IBM Bob account
# Get your API key from: https://ibm.com/bob/api-keys
IBM_BOB_API_KEY=your_ibm_bob_api_key_here
IBM_BOB_ENDPOINT=https://api.ibm.com/bob/v1

# ============================================
# Flask Web Server Configuration
# ============================================
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-key-in-production
PORT=5000

# ============================================
# Analysis Configuration
# ============================================
MIN_CONFIDENCE_THRESHOLD=0.7
AUTO_BACKUP=True
BACKUP_DIR=output/backups

# ============================================
# Report Configuration
# ============================================
REPORT_FORMAT=html
OUTPUT_DIR=output

# ============================================
# Security Configuration
# ============================================
MAX_FILE_SIZE=16777216
ALLOWED_EXTENSIONS=.py,.js,.ts,.java,.cpp,.c,.cs,.go,.rb,.php

# ============================================
# Rate Limiting (requests per minute)
# ============================================
RATE_LIMIT=60

# ============================================
# Advanced Settings
# ============================================
ENABLE_CACHING=True
CACHE_TTL=3600
PARALLEL_ANALYSIS=True
MAX_WORKERS=4

# ============================================
# Feature Flags
# ============================================
ENABLE_AUTO_FIX=True
ENABLE_TEST_GENERATION=True
ENABLE_CHAT=True
ENABLE_BATCH_ANALYSIS=True

# ============================================
# Optional Integrations
# ============================================
# Email Notifications (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# NOTIFICATION_EMAIL=admin@example.com

# Slack Notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# GitHub Integration (optional)
# GITHUB_TOKEN=your_github_personal_access_token
# GITHUB_REPO=owner/repository